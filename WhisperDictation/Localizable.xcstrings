    "Off by default: words like ‘punt’ can be ordinary text. Commands insert punctuation or newlines, never a send shortcut. Test newlines in a draft first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: words like ‘punt’ can be ordinary text. Commands insert punctuation or newlines, never a send shortcut. Test newlines in a draft first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uit: woorden als ‘punt’ kunnen gewone tekst zijn. Commando’s voegen leestekens of regeleinden in, geen verzendsneltoets. Test regeleinden eerst in een concept."
          }
        }
      }
    },
